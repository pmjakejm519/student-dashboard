rules_version = '2';
// Photos live at photos/{studentUid}/{photoId}. Students upload images (max 10 MB) only to their own folder.
// The student and IT staff can view them.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
    match /photos/{uid}/{photoId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
